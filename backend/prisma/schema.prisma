// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

model Admin {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(254)
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orderStatusHistory OrderStatusHistory[]
  paymentHistory     PaymentHistory[]

  @@index([isActive, role])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  bvid        String? @unique
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  sortOrder   Int     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id             String   @id @default(cuid())
  name           String
  sku            String?  @unique
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  isDefault      Boolean  @default(false)
  isAvailable    Boolean  @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  recipe ProductIngredient[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@index([productId])
}

model Ingredient {
  id             String  @id @default(cuid())
  name           String  @unique
  normalizedName String  @unique
  description    String?
  isActive       Boolean @default(true)

  purchaseCostPerUnit Decimal @default(0) @db.Decimal(12, 4)
  supplierName        String?

  inventory Inventory?
  recipes   ProductIngredient[]
  purchases IngredientPurchase[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  movements StockMovement[]
}

model Inventory {
  id           String  @id @default(cuid())
  quantity     Decimal @default(0) @db.Decimal(12, 3)
  unit         String
  reorderLevel Decimal @default(0) @db.Decimal(12, 3)

  ingredientId String     @unique
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model ProductIngredient {
  id              String  @id @default(cuid())
  quantity        Decimal @db.Decimal(12, 4)
  enteredQuantity Decimal @default(0) @db.Decimal(12, 4)
  enteredUnit     String  @default("kg")

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([variantId, ingredientId])
  @@index([ingredientId])
}

enum StockMovementType {
  IN
  OUT
  PURCHASE
  ADJUSTMENT
  DEDUCTION
  RESTORATION
}

model StockMovement {
  id               String            @id @default(cuid())
  type             StockMovementType
  quantity         Decimal           @db.Decimal(12, 3)
  previousQuantity Decimal           @db.Decimal(12, 3)
  newQuantity      Decimal           @db.Decimal(12, 3)
  note             String?

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  reason     String?
  adminId    String?
  purchaseId String?
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([ingredientId, createdAt])
  @@index([type, createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                     String               @id @default(cuid())
  orderNumber            String               @unique
  idempotencyKey         String?              @unique
  requestHash            String?              @db.VarChar(64)
  trackingTokenHash      String?              @unique @db.VarChar(64)
  trackingTokenEncrypted String?              @db.VarChar(255)
  customerName           String               @db.VarChar(120)
  customerPhone          String               @db.VarChar(30)
  customerEmail          String?              @db.VarChar(254)
  deliveryAddress        String               @db.VarChar(500)
  deliveryCity           String               @db.VarChar(100)
  deliveryInstructions   String?              @db.VarChar(500)
  subtotal               Decimal              @db.Decimal(12, 2)
  deliveryFee            Decimal              @default(0) @db.Decimal(12, 2)
  discount               Decimal              @default(0) @db.Decimal(12, 2)
  total                  Decimal              @db.Decimal(12, 2)
  currency               String               @default("PKR") @db.VarChar(3)
  status                 OrderStatus          @default(PENDING)
  paymentMethod          PaymentMethod
  paymentStatus          PaymentStatus        @default(UNPAID)
  paidAt                 DateTime?
  cancelledAt            DateTime?
  notes                  String?              @db.VarChar(1000)
  items                  OrderItem[]
  stockMovements         StockMovement[]
  statusHistory          OrderStatusHistory[]
  paymentHistory         PaymentHistory[]
  payments               Payment[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String          @db.VarChar(150)
  variantName String          @db.VarChar(100)
  sku         String?         @db.VarChar(100)
  quantity    Int
  unitPrice   Decimal         @db.Decimal(10, 2)
  lineTotal   Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  fromStatus OrderStatus
  toStatus   OrderStatus
  note       String?     @db.VarChar(500)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([adminId, createdAt])
}

model PaymentHistory {
  id            String               @id @default(cuid())
  fromStatus    PaymentStatus
  toStatus      PaymentStatus
  amount        Decimal              @db.Decimal(12, 2)
  currency      String               @db.VarChar(3)
  paymentMethod PaymentMethod
  note          String?              @db.VarChar(500)
  source        PaymentHistorySource @default(ADMIN)
  provider      PaymentProvider?
  orderId       String
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  adminId       String?
  admin         Admin?               @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now())

  @@index([orderId, createdAt])
  @@index([adminId, createdAt])
}

enum PaymentProvider {
  SAFEPAY
  PAYFAST
}

enum OnlinePaymentMethod {
  CARD
  JAZZCASH
  EASYPAISA
  RAAST
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentHistorySource {
  ADMIN
  GATEWAY
  SYSTEM
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model Payment {
  id                    String                @id @default(cuid())
  orderId               String
  provider              PaymentProvider
  method                OnlinePaymentMethod
  status                PaymentAttemptStatus  @default(INITIATED)
  amount                Decimal               @db.Decimal(12, 2)
  currency              String                @db.VarChar(3)
  idempotencyKey        String                @unique @db.VarChar(100)
  providerPaymentId     String?               @db.VarChar(255)
  providerTransactionId String?               @db.VarChar(255)
  checkoutUrl           String?               @db.VarChar(2048)
  failureCode           String?               @db.VarChar(100)
  failureMessage        String?               @db.VarChar(500)
  expiresAt             DateTime?
  paidAt                DateTime?
  metadata              Json?
  order                 Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents         PaymentWebhookEvent[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([provider, providerPaymentId])
  @@unique([provider, providerTransactionId])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status])
}

model PaymentWebhookEvent {
  id            String             @id @default(cuid())
  provider      PaymentProvider
  eventId       String             @db.VarChar(255)
  eventType     String             @db.VarChar(100)
  payloadHash   String             @db.VarChar(64)
  status        WebhookEventStatus @default(RECEIVED)
  paymentId     String?
  attempts      Int                @default(0)
  failureReason String?            @db.VarChar(500)
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?
  payment       Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([paymentId])
}

model IngredientPurchase {
  id              String     @id @default(cuid())
  ingredientId    String
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  enteredQuantity Decimal    @db.Decimal(12, 4)
  enteredUnit     String
  baseQuantity    Decimal    @db.Decimal(12, 4)
  totalCost       Decimal    @db.Decimal(12, 2)
  unitCostInBase  Decimal    @db.Decimal(12, 4)
  supplierName    String?
  notes           String?
  adminId         String?
  purchasedAt     DateTime   @default(now())
  createdAt       DateTime   @default(now())

  @@index([ingredientId, purchasedAt])
}

model StoreSetting {
  id                  String   @id @default("default")
  storeName           String   @default("Drinkeaze")
  tagline             String?  @default("freshly made happiness")
  contactPhone        String?
  contactEmail        String?
  address             String?
  city                String   @default("Karachi")
  deliveryFee         Decimal  @default(0) @db.Decimal(10, 2)
  freeDeliveryAbove   Decimal? @db.Decimal(10, 2)
  minOrderAmount      Decimal  @default(0) @db.Decimal(10, 2)
  codEnabled          Boolean  @default(true)
  onlinePaymentEnabled Boolean @default(true)
  updatedAt           DateTime @updatedAt
}
