    {
      "name": "Payments",
      "description": "Safepay hosted checkout. First create an ONLINE order and retain its order number and tracking token.",
      "item": [
        {
          "name": "Initiate Safepay Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-order-tracking-token",
                "value": "{{orderTrackingToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"{{paymentMethod}}\",\n  \"idempotencyKey\": \"{{paymentIdempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/payments/orders/{{orderNumber}}/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "orders",
                "{{orderNumber}}",
                "initiate"
              ]
            },
            "description": "Creates or retrieves an idempotent Safepay payment attempt and returns its hosted checkout URL. Use an order created with paymentMethod ONLINE."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('paymentIdempotencyKey', 'safepay-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment initiation returns success', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.paymentId) pm.collectionVariables.set('paymentId', body.paymentId);",
                  "  if (body.checkoutUrl) pm.collectionVariables.set('checkoutUrl', body.checkoutUrl);",
                  "  pm.test('Response includes payment ID and checkout URL', function () {",
                  "    pm.expect(body.paymentId).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.checkoutUrl).to.be.a('string').and.not.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Open Safepay Checkout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{checkoutUrl}}",
              "host": [
                "{{checkoutUrl}}"
              ]
            },
            "description": "Optional: copy the checkoutUrl returned by Initiate Safepay Payment into a Postman variable named checkoutUrl, or open it in a browser to complete sandbox checkout."
          }
        },
        {
          "name": "Verify Safepay Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-order-tracking-token",
                "value": "{{orderTrackingToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/orders/{{orderNumber}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "orders",
                "{{orderNumber}}",
                "verify"
              ]
            },
            "description": "Verifies the Safepay transaction using the provider reporter API and reconciles the payment and order status. Requires the order tracking token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment verification returns a valid response', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "});",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Verification response includes reconciliation status', function () {",
                  "    pm.expect(body).to.have.property('reconciled');",
                  "    pm.expect(body).to.have.property('paymentStatus');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
