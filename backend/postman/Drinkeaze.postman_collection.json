          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set(\"orderId\", data.id);",
                  "  pm.collectionVariables.set(\"adminOrderId\", data.id);",
                  "  pm.collectionVariables.set(\"orderNumber\", data.orderNumber);",
                  "}",
                  "const body = pm.response.json();",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.test(\"Checkout returns tracking credentials\", function () {",
                  "    pm.expect(body.orderNumber).to.be.a(\"string\");",
                  "    pm.expect(body.trackingToken).to.be.a(\"string\");",
                  "  });",
                  "  if (body.orderNumber && body.trackingToken) {",
                  "    pm.collectionVariables.set(\"orderNumber\", body.orderNumber);",
                  "    pm.collectionVariables.set(\"orderTrackingToken\", body.trackingToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
