                "exec": [
                  "pm.test(\"Admin cancellation returns 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Order is cancelled\", function () { pm.expect(body.order.status).to.eql(\"CANCELLED\"); });",
                  "pm.test(\"Inventory restoration is reported\", function () { pm.expect(body.restoredIngredients).to.be.a(\"number\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin - Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"note\": \"Order confirmed by admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/admin/{{adminOrderId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "admin",
                "{{adminOrderId}}",
                "status"
              ]
            },
            "description": "Admin-only order status transition. Change the status in the request body for the next valid step."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status update succeeds\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "  pm.test(\"Order status matches requested status\", function () {",
                  "    pm.expect(body.order.status).to.eql(pm.request.body.raw ? JSON.parse(pm.request.body.raw).status : undefined);",
                  "  });",
                  "  pm.test(\"Status history records authenticated admin\", function () {",
                  "    pm.expect(body.history.admin.id).to.be.a(\"string\");",
                  "    pm.expect(body.history.toStatus).to.eql(body.order.status);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin - Collect COD Payment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Cash collected from customer by delivery rider\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/admin/{{adminOrderId}}/collect-cod",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "admin",
                "{{adminOrderId}}",
                "collect-cod"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"COD collection returns HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Payment is marked PAID\", function () {",
                  "    pm.expect(body.order.paymentStatus).to.eql(\"PAID\");",
                  "    pm.expect(body.order.paidAt).to.be.a(\"string\");",
                  "  });",
                  "  pm.test(\"Payment history records the authenticated admin\", function () {",
                  "    pm.expect(body.history.toStatus).to.eql(\"PAID\");",
                  "    pm.expect(body.history.admin.id).to.be.a(\"string\");",
                  "    pm.expect(body.history.amount).to.exist;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
