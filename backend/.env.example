# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/drinkeaze?schema=public"
PORT=3000

# Required for secure admin login and order tracking.
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
ADMIN_BOOTSTRAP_SECRET="REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_SECRET"
ORDER_TRACKING_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARACTERS_FROM_openssl_rand_hex_32"

# Safepay hosted checkout (never put these values in the frontend).
SAFEPAY_ENV="sandbox"
SAFEPAY_SECRET_KEY=""
SAFEPAY_API_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_REDIRECT_URL="http://localhost:3001/checkout/payment-return"
SAFEPAY_CANCEL_URL="http://localhost:3001/checkout/payment-cancelled"

# Optional NestJS Observe telemetry
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""
